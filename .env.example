# Obsidian RAG Environment Configuration
# Copy this file to .env and fill in your values
# IMPORTANT: Never commit the .env file (contains secrets)

# ===== Required =====

# Vertex AI API Key for Gemini 2.5 Flash
# Get your key from: https://console.cloud.google.com/vertex-ai
VERTEX_AI_API_KEY=your-vertex-ai-api-key-here

# ===== Optional Paths =====

# Path to your Obsidian vault
# OBSIDIAN_VAULT_PATH=C:\path\to\your\vault

# RAG storage directory
# RAG_WORKING_DIR=./rag_storage

# ===== Optional Development =====

# Enable development mode (auto-reload)
# WARNING: Can cause infinite reload loop
# DEV_MODE=false
