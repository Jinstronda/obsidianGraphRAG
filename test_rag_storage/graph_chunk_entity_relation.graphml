<graph edgedefault="undirected"><node id="Machine Learning Basics">
  <data key="d0">Machine Learning Basics</data>
  <data key="d1">content</data>
  <data key="d2">Machine Learning Basics covers the fundamentals of machine learning as a subset of artificial intelligence, focusing on systems that learn and improve from experience.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Supervised Learning">
  <data key="d0">Supervised Learning</data>
  <data key="d1">concept</data>
  <data key="d2">Supervised Learning is a training method that involves using labeled data to inform the learning process.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Unsupervised Learning">
  <data key="d0">Unsupervised Learning</data>
  <data key="d1">concept</data>
  <data key="d2">Unsupervised Learning refers to the process of identifying patterns in data that does not have labels.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Deep Learning">
  <data key="d0">Deep Learning</data>
  <data key="d1">method</data>
  <data key="d2">Deep Learning is a complex approach within machine learning that utilizes neural networks with multiple layers for processing data.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Neural Networks">
  <data key="d0">Neural Networks</data>
  <data key="d1">concept</data>
  <data key="d2">Neural Networks are computing systems inspired by biological neurons, structured in interconnected layers designed for processing data.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Input Layer">
  <data key="d0">Input Layer</data>
  <data key="d1">concept</data>
  <data key="d2">The Input Layer is the first layer in a neural network that receives initial data for processing.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Hidden Layers">
  <data key="d0">Hidden Layers</data>
  <data key="d1">concept</data>
  <data key="d2">Hidden Layers are intermediate layers in a neural network that process information before sending it to the output layer.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Output Layer">
  <data key="d0">Output Layer</data>
  <data key="d1">concept</data>
  <data key="d2">The Output Layer is the final layer in a neural network that produces the result after processing through preceding layers.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Retrieval-Augmented Generation (RAG)">
  <data key="d0">Retrieval-Augmented Generation (RAG)</data>
  <data key="d1">method</data>
  <data key="d2">RAG systems integrate retrieval and generation techniques to improve AI responses using external information.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Retriever">
  <data key="d0">Retriever</data>
  <data key="d1">concept</data>
  <data key="d2">The Retriever component in RAG systems is responsible for finding relevant documents to inform AI responses.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
<node id="Generator">
  <data key="d0">Generator</data>
  <data key="d1">concept</data>
  <data key="d2">The Generator in RAG systems creates responses based on the context provided by the retrieved documents.</data>
  <data key="d3">chunk-7347422f9fc8cacef8d11016ad2cef77</data>
  <data key="d4">obsidian_vault.md</data>
  <data key="d5">1759267716</data>
</node>
